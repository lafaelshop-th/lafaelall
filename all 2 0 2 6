
local PlaceId = game.PlaceId
local JobId = game.JobId

local Scripts = {
    [93853815957083] = "https://raw.githubusercontent.com/starioth547-netizen/key-system/refs/heads/main/STARP",
}

local FallbackScript = "loadstring(game:HttpGet("https://raw.githubusercontent.com/lafaelshop-th/lafaelall/refs/heads/main/LAFAEL%20Universal"))()"

local function LoadScript(url, mode)
    local success, err = pcall(function()
        loadstring(game:HttpGet(url))()
    end)

    if success then
        print("[Universal] โหลดสคริปต์สำเร็จ (".. mode.. ") | PlaceId: ".. PlaceId)
    else
        warn("[Universal] โหลดสคริปต์ล้มเหลว:", err)
    end
end

if Scripts[PlaceId] then
    LoadScript(Scripts[PlaceId], "specific")
else
    print("[Universal] ไม่พบเกมนี้ในระบบ (PlaceId: ".. PlaceId.. ") กำลังโหลดสคริปต์กลาง...")
    LoadScript(FallbackScript, "fallback")
end
